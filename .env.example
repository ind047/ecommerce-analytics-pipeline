# ============================================================================
# Copy this file to `.env` and adjust values. Never commit the real .env.
# docker-compose reads these automatically; the local loader also reads them.
# ============================================================================

# ---- PostgreSQL (docker-compose service `postgres`) ----
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics   # local-only demo password; change if exposing the port
POSTGRES_DB=shop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Airflow ----
# LocalExecutor + Postgres backend. Used by docker-compose and by the DAG
# to build the SQLAlchemy connection string.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com
